# Tech Guardians — web server rules (Apache / LiteSpeed on Hostinger)

Options -Indexes -MultiViews
ServerSignature Off
AddType application/manifest+json .webmanifest

RewriteEngine On
RewriteBase /

# Always use HTTPS (Hostinger's free SSL). Works behind Hostinger's proxy too.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- Attack traps -----------------------------------------------------------------------------
# Paths and tools that only attackers use go to api/trap.php: it logs the visit, adds points to the
# visitor's address and blocks it automatically (see Manage -> Security). Real visitors never get here.
RewriteRule ^api/trap\.php$ - [L]

# Unusual HTTP methods (TRACE, TRACK, DEBUG, PUT, DELETE, CONNECT ...) are never needed.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$ [NC]
RewriteRule ^ api/trap.php [L]

# Security scanners that announce themselves.
RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nessus|acunetix|netsparker|wpscan|masscan|dirbuster|gobuster|feroxbuster|ffuf|wfuzz|hydra|havij|openvas|w3af|zgrab|nuclei|arachni|skipfish|whatweb|jaeles|dalfox|commix|xsstrike|metasploit|wapiti|appscan|qualys|zmeu|morfeus|webinspect) [NC]
RewriteRule ^ api/trap.php [L]

# Attack strings in the address of ANY page (script tags, path climbing, SQL, wrappers, Log4Shell ...).
RewriteCond %{QUERY_STRING} (<|%3C)\s*(script|iframe|object|embed|svg|img|body)\b [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e(/|%2f|%5c)) [NC,OR]
RewriteCond %{QUERY_STRING} union([\s+]|%20|/\*)+(all([\s+]|%20)+)?select [NC,OR]
RewriteCond %{QUERY_STRING} (etc/passwd|etc%2fpasswd|boot\.ini|win\.ini|/proc/self) [NC,OR]
RewriteCond %{QUERY_STRING} (php|data|expect|phar|zip|gopher|jar|ldap)(://|%3a%2f%2f) [NC,OR]
RewriteCond %{QUERY_STRING} (\$\{|%24%7b)(jndi|env|sys|java|lower|upper)[:%] [NC,OR]
RewriteCond %{QUERY_STRING} (base64_decode|passthru|shell_exec|proc_open|eval)(\(|%28) [NC,OR]
RewriteCond %{QUERY_STRING} (sleep|benchmark|pg_sleep|waitfor)(\(|%28|[\s+]delay) [NC,OR]
RewriteCond %{QUERY_STRING} %00 [NC]
RewriteRule ^ api/trap.php [L]

# Well-known attack targets (WordPress, phpMyAdmin, config and backup hunting, shells ...). None exist here.
RewriteRule ^(wp-admin|wp-login|wp-content|wp-includes|wp-json|wordpress|xmlrpc|phpmyadmin|pma|myadmin|adminer|dbadmin|sqladmin|cgi-bin|vendor|node_modules|server-status|server-info|actuator|solr|jenkins|boaform|hnap1|owa|ecp|autodiscover|telescope|_profiler|phpinfo|shell|c99|r57|webshell|backups?|dumps?|\.env|\.git|\.svn|\.hg|\.aws|\.ssh|\.ds_store|\.htpasswd|\.vscode|\.idea|composer\.(json|lock)|package(-lock)?\.json|id_rsa|etc/passwd)([/.]|$) api/trap.php [L,NC]
# Script and archive file names that do not exist (outside /api, which has its own rule below).
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.(php\d?|phtml|asp|aspx|jsp|jspx|cgi|pl|py|rb|sh|exe|dll|bak|old|orig|swp|sql|sqlite|zip|tar|gz|7z|rar|bz2)$ api/trap.php [L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/.*\.php$ api/trap.php [L,NC]

# The Android app package (TWA) checks this file; it is answered by api/assetlinks.php from Manage -> Mobile App.
RewriteRule ^\.well-known/assetlinks\.json$ api/assetlinks.php [L]

# ---- Files that must never be served ----------------------------------------------------------
# Never serve hidden files, backups, logs, source maps or developer files.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(bak|backup|old|orig|sql|sqlite|log|jsonl|sh|ini|env|map|md|lock|ts|tsx)$ - [F,L,NC]
RewriteRule ^api/(data|books|ctf-data)(/|$) - [F,L]
# Internal files: PHP includes, the default book list and the licence are read by the
# API only, never fetched by browsers.
RewriteRule ^api/(config|lib|security|totp-lib|pay-config)\.php$ - [F,L,NC]
RewriteRule ^api/[a-z0-9-]+-lib\.php$ - [F,L,NC]
RewriteRule ^api/[^/]+\.json$ - [F,L,NC]
# Uploaded files are data, never code: block anything script-like in /uploads.
RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp|html?|svg|shtml)$ - [F,L,NC]

# If rewriting is unavailable, unknown paths still load the React app.
ErrorDocument 404 /index.html

# Single-page app: unknown paths load the React app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Which outside sites pages may load from. If you add a new outside service, add its address here.
  # Scripts may only come from this website: inline scripts are not allowed, so an injected <script> cannot run.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://ipapi.co https://ipwho.is https://api.allorigins.win https://api.postalpincode.in https://dns.google https://rdap.org https://rdap.verisign.com https://rdap.publicinterestregistry.org https://rdap.registry.in https://rdap.identitydigital.services https://pubapi.registry.google https://api.pwnedpasswords.com https://ifsc.razorpay.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header always unset Server
  <FilesMatch "\.(js|css|png|jpe?g|webp|gif|svg|woff2?|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^(index\.html|order\.html|sw\.js|manifest\.webmanifest|offline\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
