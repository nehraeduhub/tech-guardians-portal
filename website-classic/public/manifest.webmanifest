{
  "id": "/app",
  "name": "Tech Guardians",
  "short_name": "TG Guardians",
  "description": "Cyber security learning app: courses, events, forensic tools, CTF, news and daily tips.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0b1b33",
  "theme_color": "#0b1b33",
  "categories": ["education", "security"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Courses", "url": "/app?tab=courses", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cyber News", "url": "/app?tab=news", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "CTF Lab", "url": "/ctf", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
